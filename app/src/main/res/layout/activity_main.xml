<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAFAFA"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard Materi"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#455A64"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnToThird"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Pertemuan 3"
        android:textAllCaps="false"
        android:textColor="#546E7A"
        android:elevation="2dp"
        app:backgroundTint="#E3F2FD"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnToFourth"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/btnToFourth"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="Pertemuan 4"
        android:textAllCaps="false"
        android:textColor="#546E7A"
        android:elevation="2dp"
        app:backgroundTint="#E3F2FD"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnToFifth"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnToThird" />

    <Button
        android:id="@+id/btnToFifth"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="Pertemuan 5"
        android:textAllCaps="false"
        android:textColor="#546E7A"
        android:elevation="2dp"
        app:backgroundTint="#E3F2FD"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnToSeventh"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnToFourth" />

    <Button
        android:id="@+id/btnToSeventh"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="Pertemuan 7"
        android:textAllCaps="false"
        android:textColor="#546E7A"
        android:elevation="2dp"
        app:backgroundTint="#E3F2FD"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnToFifth" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="#D32F2F"
        app:backgroundTint="#FFEBEE"
        app:cornerRadius="24dp"
        app:strokeColor="#FFCDD2"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnToSeventh" />

</androidx.constraintlayout.widget.ConstraintLayout>